{{#if resume.skills.length}}
<section class="section" id="skills">
  <h2>Skills</h2>
  <div class="skills-grid">
    {{#each resume.skills}}
    <div class="skill-category">
      {{#if name}}<h4>{{ name }}</h4>{{/if}}
      {{#if keywords.length}}
      <ul class="keywords">
        {{#each keywords}}
        <li>{{ this }}</li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    {{/each}}
  </div>
</section>
{{/if}}
